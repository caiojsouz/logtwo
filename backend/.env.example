# Servidor
PORT=3000
NODE_ENV=development

# Segurança (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Banco: Turso em produção ou arquivo local em desenvolvimento
TURSO_DATABASE_URL=file:./data/logtwo.db
TURSO_AUTH_TOKEN=

# TMDB: use o Read Access Token (v4) OU a API Key (v3)
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR

# Origem(ns) do frontend separadas por vírgula
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Em produção o padrão é "none" (Vercel/Render em domínios diferentes).
# Se usar o proxy /api da Vercel, pode definir "lax".
COOKIE_SAMESITE=

# Web Push (notificações no celular)
# Gere as chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo (mailto: você@dominio ou URL do site)
VAPID_SUBJECT=mailto:contato@logtwo.app
